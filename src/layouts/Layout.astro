---
import Header from '@/components/Header';
import AccessStatusBanner from '@/components/storefront/AccessStatusBanner';
import BottomNav from '@/components/BottomNav';
import MotionProvider from '@/components/MotionProvider';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pathname: string;
}

const { title = 'Botanical Essence', description = 'Premium Edibles & Oils', pathname } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600;6..96,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-background text-on-background antialiased selection:bg-secondary-container selection:text-on-secondary-container min-h-screen flex flex-col pb-[calc(80px+env(safe-area-inset-bottom,0px))] md:pb-0">
    <a href="#content" class="visually-hidden skip-link">Skip to content</a>
    <Header pathname={pathname} client:load />
    <div class="pt-16">
      <AccessStatusBanner client:load />
    </div>
    <MotionProvider client:load>
      <div id="content" tabindex="-1" class="flex-1 flex flex-col">
        <slot />
      </div>
    </MotionProvider>
    <BottomNav pathname={pathname} client:load />
  </body>
</html>
