---
import Layout from '@/layouts/Layout.astro';
import ProductDetailIsland from '@/components/storefront/ProductDetailIsland';
import MemberGate from '@/components/storefront/MemberGate';

export const prerender = false;

const { slug } = Astro.params;
const productSlug = String(slug);
---

<Layout
  pathname={`/product/${productSlug}`}
  title="Private Store Product | Botanica"
  description="Approved member product details from Botanica."
  robots="noindex, nofollow"
>
  <MemberGate client:load>
    <ProductDetailIsland client:load slug={productSlug} />
  </MemberGate>
</Layout>
