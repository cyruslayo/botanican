---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/landing/Hero.astro';
import ProductOverview from '@/components/landing/ProductOverview.astro';
import PromotionLandingIsland from '@/components/landing/PromotionLandingIsland';
import MembershipBenefits from '@/components/landing/MembershipBenefits.astro';
import DropperGuidePreview from '@/components/landing/DropperGuidePreview.astro';
import ClosingInvite from '@/components/landing/ClosingInvite.astro';
import InstagramHandoff from '@/components/landing/InstagramHandoff.astro';
import Faq from '@/components/landing/Faq.astro';
import LandingFooter from '@/components/landing/LandingFooter.astro';
import { buildFaqJsonLd } from '@/data/landing';

export const prerender = true;

const faqJsonLd = buildFaqJsonLd();
---

<Layout
  pathname="/"
  title="Botanica | 25 mg & 50 mg Cannabis Tinctures"
  description="Explore Botanica's 10 ml cannabis tinctures in 25 mg and 50 mg strengths, the visual dropper guide, and our invite-only member Store."
>
  <div id="public-landing">
    <main class="w-full">
      <Hero />
      <ProductOverview />
      <PromotionLandingIsland client:load />
      <MembershipBenefits />
      <DropperGuidePreview />
      <InstagramHandoff />
      <ClosingInvite />
      <Faq />
      <LandingFooter />
    </main>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
