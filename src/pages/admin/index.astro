---
import AdminLayout from '@/layouts/AdminLayout.astro';
import InstagramLinkBuilder from '@/components/admin/InstagramLinkBuilder';

// Static shell; admin data loads client-side.
export const prerender = true;

const naira = new Intl.NumberFormat('en-NG', {
  style: 'currency',
  currency: 'NGN',
  minimumFractionDigits: 2,
});
---

<AdminLayout pathname="/admin" title="Dashboard | Store Admin">
  <div class="space-y-6 md:space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h2 class="font-headline-md text-xl sm:text-headline-md text-on-surface">Dashboard Overview</h2>
        <p class="font-body-sm text-xs sm:text-sm text-on-surface-variant">Store performance, operational tools, and recent activity.</p>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-on-surface-variant">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>System Live</span>
      </div>
    </div>

    <!-- Instagram Story Link Generator Tool -->
    <InstagramLinkBuilder client:load />

    <!-- Performance Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
      <div class="bg-surface p-5 sm:p-6 rounded-2xl border border-outline-variant botanical-shadow flex flex-col justify-between">
        <div class="flex justify-between items-start mb-3">
          <div class="p-2.5 sm:p-3 bg-secondary-container rounded-xl text-base sm:text-lg"><span>💵</span></div>
          <span class="font-label-sm text-[11px] font-bold text-secondary bg-secondary/10 px-2 py-0.5 rounded-full">+14%</span>
        </div>
        <div>
          <h3 class="font-body-sm text-xs sm:text-sm text-on-surface-variant font-medium">Total Revenue</h3>
          <p class="font-headline-md text-lg sm:text-2xl text-on-surface mt-0.5 font-bold tracking-tight">{naira.format(12450)}</p>
        </div>
      </div>

      <div class="bg-surface p-5 sm:p-6 rounded-2xl border border-outline-variant botanical-shadow flex flex-col justify-between">
        <div class="flex justify-between items-start mb-3">
          <div class="p-2.5 sm:p-3 bg-secondary-container rounded-xl text-base sm:text-lg"><span>🛒</span></div>
          <span class="font-label-sm text-[11px] font-bold text-secondary bg-secondary/10 px-2 py-0.5 rounded-full">+5%</span>
        </div>
        <div>
          <h3 class="font-body-sm text-xs sm:text-sm text-on-surface-variant font-medium">Total Orders</h3>
          <p class="font-headline-md text-lg sm:text-2xl text-on-surface mt-0.5 font-bold tracking-tight">142</p>
        </div>
      </div>

      <div class="bg-surface p-5 sm:p-6 rounded-2xl border border-outline-variant botanical-shadow flex flex-col justify-between">
        <div class="flex justify-between items-start mb-3">
          <div class="p-2.5 sm:p-3 bg-secondary-container rounded-xl text-base sm:text-lg"><span>📦</span></div>
          <span class="font-label-sm text-[11px] font-bold text-on-surface-variant bg-surface-container-high px-2 py-0.5 rounded-full">Active</span>
        </div>
        <div>
          <h3 class="font-body-sm text-xs sm:text-sm text-on-surface-variant font-medium">Products in Catalog</h3>
          <p class="font-headline-md text-lg sm:text-2xl text-on-surface mt-0.5 font-bold tracking-tight">24</p>
        </div>
      </div>

      <div class="bg-surface p-5 sm:p-6 rounded-2xl border border-outline-variant botanical-shadow flex flex-col justify-between">
        <div class="flex justify-between items-start mb-3">
          <div class="p-2.5 sm:p-3 bg-secondary-container rounded-xl text-base sm:text-lg"><span>📈</span></div>
          <span class="font-label-sm text-[11px] font-bold text-secondary bg-secondary/10 px-2 py-0.5 rounded-full">+1.2%</span>
        </div>
        <div>
          <h3 class="font-body-sm text-xs sm:text-sm text-on-surface-variant font-medium">Conversion Rate</h3>
          <p class="font-headline-md text-lg sm:text-2xl text-on-surface mt-0.5 font-bold tracking-tight">3.2%</p>
        </div>
      </div>
    </div>

    <!-- Recent Orders Section with Desktop Table and Mobile Cards -->
    <div class="bg-surface rounded-2xl border border-outline-variant botanical-shadow p-4 sm:p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-headline-sm text-base sm:text-headline-sm text-on-surface font-bold">Recent Orders</h3>
          <p class="font-body-sm text-xs text-on-surface-variant">Latest customer transactions from checkout.</p>
        </div>
        <a href="/admin/orders" class="text-xs font-mono font-bold text-primary hover:text-secondary flex items-center gap-1 transition-colors">
          View All Orders ↗
        </a>
      </div>

      {/* Mobile Card List (< sm screens) */}
      <div class="sm:hidden space-y-3">
        <div class="p-3.5 bg-surface-container-low rounded-xl border border-outline-variant/50 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold text-primary">#ORD-092</span>
            <span class="px-2 py-0.5 bg-secondary-container text-on-secondary-container rounded-full text-[10px] font-bold">Fulfilled</span>
          </div>
          <div class="flex items-center justify-between text-xs text-on-surface-variant">
            <span class="font-medium text-on-surface">Sarah Jenkins</span>
            <span>Oct 24, 2023</span>
          </div>
          <div class="text-right font-mono font-bold text-primary text-sm pt-1 border-t border-outline-variant/30">
            {naira.format(145)}
          </div>
        </div>

        <div class="p-3.5 bg-surface-container-low rounded-xl border border-outline-variant/50 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold text-primary">#ORD-091</span>
            <span class="px-2 py-0.5 bg-tertiary-container text-on-tertiary-container rounded-full text-[10px] font-bold">Processing</span>
          </div>
          <div class="flex items-center justify-between text-xs text-on-surface-variant">
            <span class="font-medium text-on-surface">Michael Chen</span>
            <span>Oct 23, 2023</span>
          </div>
          <div class="text-right font-mono font-bold text-primary text-sm pt-1 border-t border-outline-variant/30">
            {naira.format(85)}
          </div>
        </div>

        <div class="p-3.5 bg-surface-container-low rounded-xl border border-outline-variant/50 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold text-primary">#ORD-090</span>
            <span class="px-2 py-0.5 bg-secondary-container text-on-secondary-container rounded-full text-[10px] font-bold">Fulfilled</span>
          </div>
          <div class="flex items-center justify-between text-xs text-on-surface-variant">
            <span class="font-medium text-on-surface">Emma Stone</span>
            <span>Oct 22, 2023</span>
          </div>
          <div class="text-right font-mono font-bold text-primary text-sm pt-1 border-t border-outline-variant/30">
            {naira.format(210)}
          </div>
        </div>
      </div>

      {/* Desktop Table (>= sm screens) */}
      <div class="hidden sm:block overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-outline-variant/60">
              <th class="pb-3 font-label-sm text-xs text-on-surface-variant uppercase tracking-wider">Order ID</th>
              <th class="pb-3 font-label-sm text-xs text-on-surface-variant uppercase tracking-wider">Customer</th>
              <th class="pb-3 font-label-sm text-xs text-on-surface-variant uppercase tracking-wider">Date</th>
              <th class="pb-3 font-label-sm text-xs text-on-surface-variant uppercase tracking-wider">Amount</th>
              <th class="pb-3 font-label-sm text-xs text-on-surface-variant uppercase tracking-wider text-right">Status</th>
            </tr>
          </thead>
          <tbody class="font-body-md text-sm text-on-surface divide-y divide-outline-variant/40">
            <tr class="hover:bg-surface-container-low/60 transition-colors">
              <td class="py-3.5 font-mono font-semibold text-primary">#ORD-092</td>
              <td class="py-3.5">Sarah Jenkins</td>
              <td class="py-3.5 text-on-surface-variant text-xs font-mono">Oct 24, 2023</td>
              <td class="py-3.5 font-mono font-medium">{naira.format(145)}</td>
              <td class="py-3.5 text-right"><span class="px-2.5 py-1 bg-secondary-container text-on-secondary-container rounded-full text-xs font-medium">Fulfilled</span></td>
            </tr>
            <tr class="hover:bg-surface-container-low/60 transition-colors">
              <td class="py-3.5 font-mono font-semibold text-primary">#ORD-091</td>
              <td class="py-3.5">Michael Chen</td>
              <td class="py-3.5 text-on-surface-variant text-xs font-mono">Oct 23, 2023</td>
              <td class="py-3.5 font-mono font-medium">{naira.format(85)}</td>
              <td class="py-3.5 text-right"><span class="px-2.5 py-1 bg-tertiary-container text-on-tertiary-container rounded-full text-xs font-medium">Processing</span></td>
            </tr>
            <tr class="hover:bg-surface-container-low/60 transition-colors">
              <td class="py-3.5 font-mono font-semibold text-primary">#ORD-090</td>
              <td class="py-3.5">Emma Stone</td>
              <td class="py-3.5 text-on-surface-variant text-xs font-mono">Oct 22, 2023</td>
              <td class="py-3.5 font-mono font-medium">{naira.format(210)}</td>
              <td class="py-3.5 text-right"><span class="px-2.5 py-1 bg-secondary-container text-on-secondary-container rounded-full text-xs font-medium">Fulfilled</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
