---
import AdminLayout from '@/layouts/AdminLayout.astro';

// Static shell; admin data loads client-side.
export const prerender = true;

const naira = new Intl.NumberFormat('en-NG', {
  style: 'currency',
  currency: 'NGN',
  minimumFractionDigits: 2,
});
---

<AdminLayout pathname="/admin" title="Dashboard | Store Admin">
  <div class="space-y-8">
    <div class="flex justify-between items-center">
      <h2 class="font-headline-md text-headline-md text-on-surface">Dashboard Overview</h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      <div class="bg-surface p-6 rounded-xl border border-outline-variant botanical-shadow">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-secondary-container rounded-lg"><span>💵</span></div>
          <span class="font-label-sm text-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded-full">+14%</span>
        </div>
        <h3 class="font-body-md text-body-md text-on-surface-variant">Total Revenue</h3>
        <p class="font-headline-md text-headline-md text-on-surface mt-1">{naira.format(12450)}</p>
      </div>
      <div class="bg-surface p-6 rounded-xl border border-outline-variant botanical-shadow">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-secondary-container rounded-lg"><span>🛒</span></div>
          <span class="font-label-sm text-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded-full">+5%</span>
        </div>
        <h3 class="font-body-md text-body-md text-on-surface-variant">Total Orders</h3>
        <p class="font-headline-md text-headline-md text-on-surface mt-1">142</p>
      </div>
      <div class="bg-surface p-6 rounded-xl border border-outline-variant botanical-shadow">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-secondary-container rounded-lg"><span>📦</span></div>
          <span class="font-label-sm text-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded-full">0%</span>
        </div>
        <h3 class="font-body-md text-body-md text-on-surface-variant">Products Active</h3>
        <p class="font-headline-md text-headline-md text-on-surface mt-1">24</p>
      </div>
      <div class="bg-surface p-6 rounded-xl border border-outline-variant botanical-shadow">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-secondary-container rounded-lg"><span>📈</span></div>
          <span class="font-label-sm text-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded-full">+1.2%</span>
        </div>
        <h3 class="font-body-md text-body-md text-on-surface-variant">Conversion Rate</h3>
        <p class="font-headline-md text-headline-md text-on-surface mt-1">3.2%</p>
      </div>
    </div>

    <div class="bg-surface p-6 rounded-xl border border-outline-variant botanical-shadow">
      <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6">Recent Orders</h3>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] text-left border-collapse">
          <thead>
            <tr class="border-b border-outline-variant">
              <th class="pb-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Order ID</th>
              <th class="pb-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Customer</th>
              <th class="pb-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Date</th>
              <th class="pb-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Amount</th>
              <th class="pb-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Status</th>
            </tr>
          </thead>
          <tbody class="font-body-md text-body-md text-on-surface">
            <tr class="border-b border-outline-variant/50">
              <td class="py-4">#ORD-092</td>
              <td class="py-4">Sarah Jenkins</td>
              <td class="py-4">Oct 24, 2023</td>
              <td class="py-4">{naira.format(145)}</td>
              <td class="py-4"><span class="px-2 py-1 bg-secondary-container text-on-secondary-container rounded-full text-xs">Fulfilled</span></td>
            </tr>
            <tr class="border-b border-outline-variant/50">
              <td class="py-4">#ORD-091</td>
              <td class="py-4">Michael Chen</td>
              <td class="py-4">Oct 23, 2023</td>
              <td class="py-4">{naira.format(85)}</td>
              <td class="py-4"><span class="px-2 py-1 bg-tertiary-container text-on-tertiary-container rounded-full text-xs">Processing</span></td>
            </tr>
            <tr>
              <td class="py-4">#ORD-090</td>
              <td class="py-4">Emma Stone</td>
              <td class="py-4">Oct 22, 2023</td>
              <td class="py-4">{naira.format(210)}</td>
              <td class="py-4"><span class="px-2 py-1 bg-secondary-container text-on-secondary-container rounded-full text-xs">Fulfilled</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
