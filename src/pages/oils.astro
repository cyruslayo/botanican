---
import Layout from '@/layouts/Layout.astro';
import MemberGate from '@/components/storefront/MemberGate';
import ProductCatalogIsland from '@/components/storefront/ProductCatalogIsland';
import MemberPromotionSection from '@/components/storefront/MemberPromotionSection';

export const prerender = false;
---

<Layout
  pathname="/oils"
  title="Store | Botanica"
  robots="noindex, nofollow"
>
  <MemberGate client:load>
    <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pb-section-gap pt-24 md:pt-32">
      <section class="py-section-gap text-center max-w-2xl mx-auto">
        <h1 class="font-headline-md text-headline-md text-primary mb-stack-md">Store</h1>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Browse available tinctures from Botanica. This store is for approved members.
        </p>
      </section>

      <MemberPromotionSection client:load />
      <ProductCatalogIsland client:load category="Oils" />
    </main>
  </MemberGate>
</Layout>
