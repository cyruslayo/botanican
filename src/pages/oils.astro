---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/storefront/ProductCard.astro';
import MemberGate from '@/components/storefront/MemberGate';
import { getProductsByCategory } from '@/lib/products';
import type { Product } from '@/lib/types';

// Catalog pages are rendered on-demand so new products appear immediately
// after they are added in the admin panel.
export const prerender = false;

let products: Product[] = [];
try {
  products = await getProductsByCategory('Oils');
} catch (error) {
  console.warn('Falling back to empty oils collection:', error);
}
---

<Layout pathname="/oils" title="Botanical Oils | Botanical Essence">
  <MemberGate client:load>
    <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pb-section-gap pt-24 md:pt-32">
      <section class="py-section-gap text-center max-w-2xl mx-auto">
        <h2 class="font-headline-md text-headline-md text-primary mb-stack-md">Botanical Oils & Tinctures</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Experience the pure essence of nature. Our premium, full-spectrum oils are meticulously extracted to preserve the delicate balance of cannabinoids and terpenes, delivering targeted relief and elevated tranquility.
        </p>
      </section>

      <div class="flex flex-wrap items-center justify-between mb-8 border-b border-outline-variant/30 pb-4">
        <div class="flex gap-4">
          <button class="font-label-sm text-label-sm bg-surface-container-low text-primary px-4 py-2 rounded-full border border-outline-variant/50 hover:bg-surface-container transition-colors">Filter</button>
          <button class="font-label-sm text-label-sm bg-surface-container-low text-primary px-4 py-2 rounded-full border border-outline-variant/50 hover:bg-surface-container transition-colors hidden md:block">Strength</button>
        </div>
        <span class="font-body-md text-body-md text-on-surface-variant">{products.length} Products</span>
      </div>

      {products.length === 0 ? (
        <div class="col-span-full py-20 text-center font-body-md text-on-surface-variant">No products found in this category.</div>
      ) : (
        <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-gutter items-start">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      )}
    </main>
  </MemberGate>
</Layout>

