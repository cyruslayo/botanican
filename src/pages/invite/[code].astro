---
import Layout from '@/layouts/Layout.astro';
import InviteRegistration from '@/components/storefront/InviteRegistration';

export const prerender = false;

const { code } = Astro.params;
---

<Layout
  pathname={`/invite/${code || ''}`}
  title="Member Invite | Botanica"
  description="Botanica is invite-only. Enter a valid member invite to request access; approved members can enter the private store."
>
  <main class="w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg md:py-section-gap">
    <InviteRegistration initialCode={code} client:load />
  </main>
</Layout>
