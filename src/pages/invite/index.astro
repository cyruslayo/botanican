---
import Layout from '@/layouts/Layout.astro';
import InviteRegistration from '@/components/storefront/InviteRegistration';

export const prerender = true;
---

<Layout
  pathname="/invite"
  title="Account & Invites | Botanica"
  description="Manage Botanica member access, invite links and private Store access."
>
  <main class="w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg md:py-section-gap">
    <InviteRegistration client:load />
  </main>
</Layout>
