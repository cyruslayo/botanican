---
import Layout from '@/layouts/Layout.astro';
import Masthead from '@/components/journal/Masthead.astro';
import ArticleShareBar from '@/components/journal/ArticleShareBar';
import ArticleCalloutBox from '@/components/journal/ArticleCalloutBox';
import { ARTICLES, type Article } from '@/data/journal';

export const prerender = true;

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<Layout
  pathname={`/journal/${article.slug}`}
  title={`${article.title} | The Botanical Gazette`}
  description={article.excerpt}
  image={article.image}
  type="article"
>
  <Masthead />

  <article class="w-full py-12 md:py-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="max-w-3xl mx-auto space-y-8">
      <nav aria-label="Breadcrumb">
        <a
          href="/journal"
          class="font-label-sm text-xs font-bold uppercase tracking-widest text-secondary hover:text-primary transition-colors flex items-center gap-2"
        >
          &larr; Back to Gazette Index
        </a>
      </nav>

      <header class="space-y-4 border-b border-outline-variant/40 pb-8">
        <div class="flex flex-wrap items-center gap-3 text-on-surface-variant font-mono text-xs">
          <span class="px-3 py-1 bg-secondary-container/60 rounded-full text-secondary font-bold uppercase tracking-widest text-[11px]">
            {article.category}
          </span>
          <span>{article.volume} &bull; {article.issue}</span>
          <span>&bull;</span>
          <span>{article.date}</span>
          <span>&bull;</span>
          <span>{article.readTime}</span>
        </div>

        <h1 class="font-display-lg md:font-display-xl text-display-lg md:text-display-xl text-primary leading-tight">
          {article.title}
        </h1>

        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          {article.subtitle}
        </p>

        <div class="pt-4 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-surface-container-high border border-outline-variant/50 flex items-center justify-center font-mono font-bold text-primary text-sm">
            {article.author.name.split(' ').map((n: string) => n[0]).join('')}
          </div>
          <div>
            <p class="font-body-sm text-body-sm font-bold text-primary">{article.author.name}</p>
            <p class="font-body-sm text-xs text-on-surface-variant">{article.author.role}</p>
          </div>
        </div>
      </header>

      <div class="rounded-xl overflow-hidden aspect-[16/9] bg-surface-container-low botanical-shadow">
        <img
          src={article.image}
          alt={article.title}
          referrerpolicy="no-referrer"
          class="w-full h-full object-cover"
        />
      </div>

      <div id="thesis" class="p-6 sm:p-8 rounded-xl bg-secondary-container/30 border border-secondary/20 target-glow-effect transition-shadow">
        <p class="font-mono text-[11px] uppercase tracking-widest text-secondary font-bold mb-2">
          Central Monograph Thesis
        </p>
        <p class="font-display-sm text-display-sm text-primary italic font-normal">
          &ldquo;{article.thesis}&rdquo;
        </p>
      </div>

      <div id="content" class="max-w-none space-y-6 text-on-surface font-body-lg text-body-lg leading-relaxed pt-4">
        {article.content.map((paragraph) => (
          <p class="first-of-type:first-letter:font-display-xl first-of-type:first-letter:text-5xl first-of-type:first-letter:mr-2 first-of-type:first-letter:float-left first-of-type:first-letter:text-primary">
            {paragraph}
          </p>
        ))}
      </div>

      <div id="takeaways" class="mt-12 p-6 sm:p-8 rounded-2xl bg-surface-container-low border border-outline-variant/50 space-y-4 target-glow-effect transition-shadow">
        <h3 class="font-headline-sm text-headline-sm text-primary">
          Key Takeaways
        </h3>
        <ul class="space-y-2.5">
          {article.keyTakeaways.map((takeaway) => (
            <li class="flex items-start gap-3 font-body-md text-body-md text-on-surface-variant">
              <span class="w-1.5 h-1.5 rounded-full bg-secondary mt-2 shrink-0"></span>
              <span>{takeaway}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pt-6">
        <ArticleShareBar title={article.title} slug={article.slug} client:load />
      </div>

      <ArticleCalloutBox
        callout={article.callout}
        fallbackProductSlug={article.relatedProductSlug}
        fallbackProductName={article.relatedProductName}
        client:load
      />

      <footer class="pt-8 border-t border-outline-variant/40 flex justify-between items-center">
        <a
          href="/journal"
          class="font-label-sm text-xs uppercase tracking-widest text-secondary hover:text-primary font-bold underline underline-offset-4"
        >
          &larr; Return to Library
        </a>

        <a
          href="/#invite"
          class="font-label-sm text-xs uppercase tracking-widest text-primary hover:text-secondary font-bold underline underline-offset-4"
        >
          Apply for Membership &rarr;
        </a>
      </footer>
    </div>
  </article>
</Layout>
