---
import Layout from '@/layouts/Layout.astro';
import Masthead from '@/components/journal/Masthead.astro';
import ArticleCard from '@/components/journal/ArticleCard.astro';
import ApothecaryCallout from '@/components/journal/ApothecaryCallout';
import { getAllArticles } from '@/data/journal';

export const prerender = true;

const articles = await getAllArticles();
---

<Layout
  pathname="/journal"
  title="The Botanical Gazette | Essays, Monographs & Chronobiology"
  description="The official publication of Botanica. Investigative monographs on phytochemistry, circadian architecture, and modern titration rituals."
>
  <Masthead />

  <main class="w-full py-16 md:py-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto space-y-16">
    <div class="max-w-2xl space-y-4">
      <span class="font-label-sm text-xs font-bold uppercase tracking-widest text-secondary">
        The Archive &bull; All Issues
      </span>
      <h1 class="font-display-lg md:font-display-xl text-display-lg md:text-display-xl text-primary">
        The Botanical Gazette
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Investigative monographs on circadian science, supercritical fluid chemistry, and sensory wind-down design. Published seasonally for discerning botanical patrons.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>

    <ApothecaryCallout client:load />
  </main>
</Layout>
