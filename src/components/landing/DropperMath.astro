---
/**
 * P1.2 - Milligram math from the label.
 * P1.3 - Pipette markings: precision dosing without guesswork.
 */
import DropperCalculator from './DropperCalculator';

const marks = [
  { ml: '1.0 ml', top: 0 },
  { ml: '0.75 ml', top: 25 },
  { ml: '0.5 ml', top: 50 },
  { ml: '0.25 ml', top: 75 },
];
---

<section id="dose" class="w-full bg-surface-container-low border-y border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <h2 class="font-headline-lg text-headline-lg text-primary">Dropper math, made simple</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        One squeeze is not a dose. The marking on the pipette is. Do the math once, then repeat it with confidence.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter md:gap-x-16 mt-12 items-start">
      <div class="md:col-span-5 space-y-6 reveal">
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Most 30 ml bottles print one number: the total milligrams inside. Divide by the 30 millilitres of carrier oil, and every millilitre carries an equal share. A quarter pipette carries a quarter of that share.
        </p>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          A full pipette is roughly 20 drops, so the small graduations matter more than the strength of the squeeze.
        </p>

        <div class="flex items-end gap-4 pt-4" aria-hidden="true">
          <div class="relative w-12 h-56">
            <div class="absolute inset-x-0 top-0 bottom-0 rounded-full border border-outline bg-surface">
              <div class="absolute inset-x-1 bottom-1 top-1 rounded-full bg-secondary-container/60"></div>
            </div>
          </div>
          <div class="relative flex-1 h-56">
            {marks.map((mark) => (
              <div class="absolute inset-x-0 flex items-center gap-2" style={`top:${mark.top}%`}>
                <div class="w-3 h-px bg-outline"></div>
                <span class="font-mono text-xs text-on-surface-variant">{mark.ml}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="md:col-span-7 reveal">
        <DropperCalculator client:visible />
      </div>
    </div>
  </div>
</section>
