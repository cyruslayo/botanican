---
/**
 * P2.1 - The impatient redose trap.
 * P2.2 - Golden rules for consistent titration.
 */
import { Hourglass, Scale, NotebookPen } from 'lucide-react';
import SectionShare from './SectionShare';

const rules = [
  {
    icon: Scale,
    title: 'Keep the draw consistent',
    body: 'Use the same visual reference when you want a useful comparison.',
  },
  {
    icon: Hourglass,
    title: 'Keep the route consistent',
    body: 'Changing the route can also change how the experience develops.',
  },
  {
    icon: NotebookPen,
    title: 'Change one thing at a time',
    body: 'Make one change, then learn from that experience before changing something else.',
  },
];
---

<section id="golden-hour" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter md:gap-x-16 items-start">
      <div class="md:col-span-6 space-y-stack-md reveal">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
            Responsible Use
          </span>
          <SectionShare
            client:idle
            anchor="golden-hour"
            title="Give It Time"
            text="See why patience makes a cannabis routine easier to understand."
          />
        </div>
        <h2 class="font-headline-lg text-headline-lg text-primary">It has not arrived yet. Give it time.</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          Adding more too quickly makes the experience harder to understand.
        </p>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          When you want to understand how a tincture fits your routine, patience is the most useful tool. Allowing ample time before drawing conclusions gives the experience space to develop naturally.
        </p>
        <div class="pt-4 border-t border-outline-variant/40">
          <p class="font-body-sm text-body-sm text-on-surface-variant/90 leading-relaxed font-medium">
            Do not drive or operate machinery after THC use. Follow local laws and workplace policies.
          </p>
        </div>
      </div>

      <div class="md:col-span-6 md:pl-8 reveal">
        <h3 class="font-headline-sm text-headline-sm text-primary mb-6">Three principles of deliberate use</h3>
        <div class="space-y-2">
          {rules.map(({ icon: Icon, title, body }) => (
            <div class="flex gap-4 py-4 border-t border-outline-variant/40 last:border-b">
              <div class="w-10 h-10 rounded-full bg-secondary-container/60 text-on-secondary-container flex items-center justify-center shrink-0">
                <Icon size={18} strokeWidth={1.5} aria-hidden="true" />
              </div>
              <div>
                <h4 class="font-headline-sm text-headline-sm text-primary">{title}</h4>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
