---
import { OILS_IMAGE } from '@/data/landing';

const productFacts = [
  {
    label: 'Small-batch tincture',
    detail: 'A simple liquid format in a discreet dropper bottle.',
  },
  {
    label: 'Visual dropper guide',
    detail: 'Use the visible liquid level as an approximate reference.',
  },
  {
    label: 'Private member store',
    detail: 'The private store is for approved members.',
  },
];
---

<section id="format" class="w-full bg-surface-container-low border-y border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
      <div class="md:col-span-5">
        <div class="aspect-[4/5] max-w-md rounded-xl overflow-hidden botanical-shadow bg-surface-container-lowest">
          <img
            src={OILS_IMAGE}
            alt="Generic tincture bottle and botanical ingredients"
            referrerpolicy="no-referrer"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
            width="800"
            height="1000"
          />
        </div>
      </div>

      <div class="md:col-span-7 space-y-stack-md">
        <div class="max-w-2xl space-y-4">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
            The product format
          </span>
          <h2 class="font-headline-lg text-headline-lg text-primary">A simple liquid format.</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
            Botanica makes small-batch cannabis tinctures in dropper bottles. The visual guide helps you compare liquid levels in an unmarked dropper.
          </p>
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-outline-variant/40">
          {productFacts.map((fact, index) => (
            <li class="space-y-2">
              <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">0{index + 1}</span>
              <h3 class="font-headline-sm text-headline-sm text-primary">{fact.label}</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">{fact.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
