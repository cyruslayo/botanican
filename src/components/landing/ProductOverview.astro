---
import { OILS_IMAGE } from '@/data/landing';
import MemberAccessCta from '@/components/storefront/MemberAccessCta';
---

<section id="range" class="w-full bg-surface-container-low border-y border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
      <div class="md:col-span-5">
        <div class="aspect-[4/5] max-w-md rounded-xl overflow-hidden botanical-shadow bg-surface-container-lowest">
          <img
            src={OILS_IMAGE}
            alt="Generic tincture bottle and botanical ingredients"
            referrerpolicy="no-referrer"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
            width="800"
            height="1000"
          />
        </div>
      </div>

      <div class="md:col-span-7 space-y-stack-md">
        <div class="max-w-2xl space-y-4">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
            The current range
          </span>
          <h2 class="font-headline-lg text-headline-lg text-primary">Choose 25 mg or 50 mg.</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
            Same 10 ml bottle. Same dropper format. Two total strengths.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-outline-variant/40">
          <article class="rounded-xl bg-surface p-6 border border-outline-variant/50 space-y-3">
            <h3 class="font-headline-md text-headline-md text-primary">25 mg THC</h3>
            <p class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">25 mg THC · 10 ml</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">The lower-strength bottle in the current Botanica range.</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Same compact bottle and unmarked glass dropper, with 25 mg total THC in the bottle.</p>
          </article>
          <article class="rounded-xl bg-surface p-6 border border-outline-variant/50 space-y-3">
            <h3 class="font-headline-md text-headline-md text-primary">50 mg THC</h3>
            <p class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">50 mg THC · 10 ml</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">The higher-strength bottle in the current Botanica range.</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Same 10 ml format, with 50 mg total THC in the bottle.</p>
          </article>
        </div>

        <div class="flex flex-col gap-4 border-t border-outline-variant/40 pt-5 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[38ch]">Approved members can see current pricing, availability and batch information in the Store.</p>
          <MemberAccessCta variant="product" client:load />
        </div>
      </div>
    </div>
  </div>
</section>
