---
/**
 * P1.1 - Epithelial permeation / sublingual absorption.
 * P1.6 - Administration route comparison (liquid oils vs alternative formats).
 */
import { OILS_IMAGE } from '@/data/landing';

const routes = [
  {
    format: 'Sublingual tincture',
    onset: '15-30 min onset',
    control: 'Steered drop by drop. The easiest route to titrate precisely.',
  },
  {
    format: 'Edible pastille',
    onset: '60-90 min onset',
    control: 'Pre-measured and discreet. Slower to arrive, stronger per milligram.',
  },
  {
    format: 'Capsule',
    onset: '45-90 min onset',
    control: 'Fixed and familiar. No mid-course adjustments once taken.',
  },
];
---

<section id="mechanism" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter md:gap-x-16">
      <div class="md:col-span-6 space-y-stack-md reveal">
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
          The Mechanism
        </span>
        <h2 class="font-headline-lg text-headline-lg text-primary">Under the tongue, or swallowed?</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          The tissue beneath your tongue is thin, warm, and threaded with capillaries. Hold the dose there for 30 to 60 seconds and the active compounds pass straight into the bloodstream, skipping the stomach entirely.
        </p>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Swallow it immediately and the same amount takes the long road: digestion first, then liver metabolism, then a later and heavier arrival that is harder to steer.
        </p>
      </div>

      <div class="md:col-span-6 reveal">
        <figure>
          <div class="aspect-[4/3] rounded-xl overflow-hidden botanical-shadow bg-surface-container-low">
            <img
              src={OILS_IMAGE}
              alt="Amber tincture bottle with a glass dropper, held above the tongue line"
              referrerpolicy="no-referrer"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
              width="960"
              height="720"
            />
          </div>
          <figcaption class="font-body-sm text-body-sm text-on-surface-variant mt-3">
            MCT carrier oil carries the extract. The mucosa does the rest.
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="mt-14 md:mt-16 reveal-group">
      {routes.map((route) => (
        <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] sm:items-baseline gap-1 sm:gap-8 py-5 border-t border-outline-variant/40 last:border-b">
          <div>
            <h3 class="font-headline-sm text-headline-sm text-primary">{route.format}</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">{route.control}</p>
          </div>
          <span class="font-mono text-sm font-bold text-secondary sm:justify-self-end whitespace-nowrap">
            {route.onset}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
