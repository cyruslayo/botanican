---
/**
 * Edible-to-tincture bridge:
 * Compares familiar edible format with liquid tincture format.
 */
import { OILS_IMAGE } from '@/data/landing';
import SectionShare from './SectionShare';

const comparisons = [
  {
    edible: 'Usually comes as a fixed piece.',
    botanica: 'Uses a liquid draw you can repeat visually.',
  },
  {
    edible: 'Usually goes through digestion.',
    botanica: 'Can be held under the tongue or swallowed.',
  },
  {
    edible: 'Changing the amount usually means changing the portion.',
    botanica: 'You can choose a smaller or larger visual draw.',
  },
  {
    edible: 'Looks and feels like food.',
    botanica: 'Uses a small, discreet dropper bottle.',
  },
];
---

<section id="format" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter md:gap-x-16 items-center">
      <div class="md:col-span-6 space-y-stack-md reveal">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
            The Format
          </span>
          <SectionShare
            client:idle
            anchor="format"
            title="What Changes From Edibles to Tinctures?"
            text="See how a liquid tincture differs from a familiar fixed edible portion."
          />
        </div>
        <h2 class="font-headline-lg text-headline-lg text-primary">
          You already know edibles. Here is what changes.
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          Gummies and brownies give you a familiar fixed portion. A tincture changes the format: liquid, discreet, and adjustable by visual draw.
        </p>
      </div>

      <div class="md:col-span-6 reveal">
        <figure>
          <div class="aspect-[4/3] rounded-xl overflow-hidden botanical-shadow bg-surface-container-low">
            <img
              src={OILS_IMAGE}
              alt="Amber tincture bottle with a dropper"
              referrerpolicy="no-referrer"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
              width="960"
              height="720"
            />
          </div>
          <figcaption class="font-body-sm text-body-sm text-on-surface-variant mt-3">
            A liquid format designed for discretion and visual reference.
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="mt-14 md:mt-16 reveal-group">
      <div class="hidden sm:grid sm:grid-cols-2 gap-8 pb-3 border-b border-outline-variant/60 font-label-sm text-xs uppercase tracking-widest text-on-surface-variant font-bold">
        <span>Familiar Edible</span>
        <span class="text-secondary">Botanica Tincture</span>
      </div>
      {comparisons.map((item) => (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-8 py-5 border-b border-outline-variant/40">
          <div>
            <span class="sm:hidden font-label-sm text-[11px] uppercase tracking-widest text-on-surface-variant/70 font-bold block mb-1">
              Familiar Edible
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{item.edible}</p>
          </div>
          <div>
            <span class="sm:hidden font-label-sm text-[11px] uppercase tracking-widest text-secondary font-bold block mb-1">
              Botanica Tincture
            </span>
            <p class="font-body-md text-body-md text-primary font-bold leading-relaxed">{item.botanica}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
