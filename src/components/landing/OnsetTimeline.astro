---
/**
 * Administration route explanation:
 * Explains two administration routes without guaranteed timing windows or strength comparisons.
 */
const routeCards = [
  {
    title: 'Held under the tongue',
    body: 'This route can feel sooner because the tincture spends time against tissue beneath the tongue.',
  },
  {
    title: 'Swallowed',
    body: 'This route passes through digestion and often takes longer to feel.',
  },
];
---

<section id="onset" class="w-full bg-surface-container-low border-b border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
        Administration Routes
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary">The same tincture can take two routes.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        How you take a tincture influences how your body absorbs it. Understanding both routes helps you choose a consistent method for your routine.
      </p>
    </div>

    <!-- Two simple route cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mt-12 reveal-group">
      {routeCards.map((card) => (
        <div class="bg-surface rounded-2xl p-6 sm:p-8 border border-outline-variant/40 botanical-shadow space-y-3">
          <span class="font-label-sm text-xs uppercase tracking-widest text-secondary font-bold block">
            Route Option
          </span>
          <h3 class="font-headline-sm text-headline-sm text-primary">
            {card.title}
          </h3>
          <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
            {card.body}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-8 pt-6 border-t border-outline-variant/30 reveal">
      <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[60ch] leading-relaxed">
        Timing varies between people and can change with food, route, and other factors.
      </p>
    </div>
  </div>
</section>
