---
/**
 * Route and onset education:
 * Explains held under tongue vs swallowed without guaranteed onset claims.
 */
const routes = [
  {
    id: 'sublingual',
    label: 'Held under the tongue',
    note: 'The tincture stays against tissue beneath the tongue before you swallow it. This route can feel sooner.',
    tag: 'Earlier Route',
  },
  {
    id: 'swallowed',
    label: 'Swallowed',
    note: 'The tincture passes through digestion. This route often takes longer to feel.',
    tag: 'Longer Route',
  },
];
---

<section id="onset" class="w-full bg-surface-container-low border-b border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <h2 class="font-headline-lg text-headline-lg text-primary">Two routes. Different timing.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        How you take a tincture changes how it travels. Understanding the two primary administration routes helps you keep your routine consistent.
      </p>
    </div>

    <!-- Route comparison cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 reveal">
      {routes.map((route) => (
        <div class="bg-surface rounded-2xl p-8 border border-outline-variant/40 botanical-shadow flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="font-label-sm text-xs font-bold uppercase tracking-widest text-secondary">
                {route.label}
              </span>
              <span class="font-mono text-xs px-3 py-1 bg-surface-container-high rounded-full text-primary font-bold">
                {route.tag}
              </span>
            </div>
            <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
              {route.note}
            </p>
          </div>
        </div>
      ))}
    </div>

    <p class="font-body-sm text-body-sm text-on-surface-variant mt-10 max-w-[58ch] reveal">
      Timing varies between people and can change with food, route, and other factors.
    </p>
  </div>
</section>
