---
/**
 * Deliberate-use identity:
 * Focuses on discretion, repeatable method, patient approach, and adult routine.
 */
import { Shield, Repeat, Clock, UserCheck } from 'lucide-react';

const identityPoints = [
  {
    icon: Shield,
    title: 'Discreet format',
    body: 'No smoke and no edible format.',
  },
  {
    icon: Repeat,
    title: 'Repeatable method',
    body: 'Use the same visual draw and route when you want a useful comparison.',
  },
  {
    icon: Clock,
    title: 'Patient approach',
    body: 'Understand one experience before changing the next one.',
  },
  {
    icon: UserCheck,
    title: 'Adult routine',
    body: 'Built around deliberate use, not cannabis spectacle.',
  },
];
---

<section id="identity" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
        The Philosophy
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary">
        For people who prefer control over spectacle.
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Botanica is designed for adults who want cannabis to fit a private, deliberate routine.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mt-12 reveal-group">
      {identityPoints.map(({ icon: Icon, title, body }) => (
        <div class="bg-surface-container-low rounded-2xl p-6 sm:p-8 border border-outline-variant/40 botanical-shadow flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-secondary-container/70 text-on-secondary-container flex items-center justify-center shrink-0 mt-0.5">
            <Icon size={18} strokeWidth={1.5} aria-hidden="true" />
          </div>
          <div class="space-y-1">
            <h3 class="font-headline-sm text-headline-sm text-primary">{title}</h3>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
