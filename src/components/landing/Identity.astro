---
/**
 * Identity section:
 * Cannabis without the recreational spectacle. Built for deliberate, adult routines.
 */
import { ShieldCheck, Eye, Compass, Moon } from 'lucide-react';

const pillars = [
  {
    icon: ShieldCheck,
    title: 'Discreet format',
    description: 'No smoke. No gummy or brownie format. Just a small dropper bottle.',
  },
  {
    icon: Eye,
    title: 'Repeatable method',
    description: 'Use the same visual draw and route when you want a useful comparison.',
  },
  {
    icon: Compass,
    title: 'Patient approach',
    description: 'Understand one experience before changing the next one.',
  },
  {
    icon: Moon,
    title: 'Adult routine',
    description: 'Built around deliberate use, not cannabis spectacle.',
  },
];
---

<section id="identity" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
        Identity
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary">Cannabis without the recreational spectacle.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Botanica is for adults who want cannabis to fit a private, deliberate routine.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 reveal-group">
      {pillars.map(({ icon: Icon, title, description }) => (
        <div class="p-8 rounded-2xl bg-surface-container-low border border-outline-variant/40 botanical-shadow flex gap-5">
          <div class="w-12 h-12 rounded-2xl bg-surface border border-outline-variant/60 flex items-center justify-center text-secondary shrink-0">
            <Icon size={22} strokeWidth={1.5} aria-hidden="true" />
          </div>
          <div class="space-y-2">
            <h3 class="font-headline-sm text-headline-sm text-primary">{title}</h3>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
