---
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-outline-variant/40 bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <p class="font-display-sm text-display-sm text-primary tracking-tight">BOTANICA</p>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-2 max-w-[36ch]">
          Private apothecary. Delivered discreetly across Maitama, Asokoro, Wuse, and Guzape.
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-col gap-3">
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">Explore</span>
        <a href="/oils" class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors w-fit">Botanical Oils</a>
        <a href="/edibles" class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors w-fit">Artisanal Edibles</a>
        <a href="/invite" class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors w-fit">Member Access</a>
      </nav>

      <div>
        <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[40ch]">
          For adults only. Botanical support for general wellness, not medical advice.
        </p>
        <p class="font-body-sm text-body-sm text-on-surface-variant/70 mt-4">
          &copy; {year} Botanica. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
