---
/**
 * FAQ - P2.3 bedtime timing, P2.4 morning grogginess, P2.6 repeatable routine,
 * P3.6 tracking, redose patience, spectrum choice. JSON-LD rendered in index.astro.
 */
import FaqAccordion from './FaqAccordion';
import { FAQ_ITEMS } from '@/data/landing';
---

<section id="faq" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md mb-12 reveal">
      <h2 class="font-headline-lg text-headline-lg text-primary">Actual questions from people who nearly got it wrong</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        The details first-time members ask about most, before the code is even applied for.
      </p>
    </div>

    <div class="max-w-3xl reveal">
      <FaqAccordion client:visible items={FAQ_ITEMS} />
      
      <div class="mt-10 p-6 rounded-2xl bg-surface-container-low border border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <p class="font-headline-sm text-primary">Have a question not answered here?</p>
          <p class="font-body-sm text-on-surface-variant mt-0.5">Send it to our apothecary desk. The sharpest inquiries become the next entry.</p>
        </div>
        <a
          href="mailto:concierge@botanica.internal?subject=Botanical%20Dosing%20Question"
          class="shrink-0 inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-primary text-primary font-label-sm text-xs uppercase tracking-widest font-bold hover:bg-primary hover:text-on-primary transition-colors"
        >
          Ask the Apothecary
        </a>
      </div>
    </div>
  </div>
</section>
