---
/**
 * Purchase-oriented homepage FAQ. JSON-LD is rendered in index.astro.
 */
import FaqAccordion from './FaqAccordion';
import { FAQ_ITEMS } from '@/data/landing';
---

<section id="faq" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md mb-12 reveal">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
        Learn more
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary">Frequently asked questions</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Common questions about tinctures, the visual guide, and member access.
      </p>
    </div>

    <div class="max-w-3xl reveal">
      <FaqAccordion client:visible items={FAQ_ITEMS} />
    </div>
  </div>
</section>
