---
import { HERO_IMAGE } from '@/data/landing';
import MemberAccessCta from '@/components/storefront/MemberAccessCta';
---

<section id="intro" class="w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center py-10 md:py-16">
    <div class="md:col-span-7 lg:col-span-6 space-y-stack-md load-in">
      <span class="inline-flex items-center gap-2 px-4 py-1 bg-secondary-container/60 rounded-full border border-secondary/30 font-label-sm text-xs uppercase tracking-widest text-secondary font-bold">
        INVITE-ONLY · SMALL-BATCH CANNABIS TINCTURES
      </span>

      <h1 class="font-display-lg md:font-display-xl text-display-lg md:text-display-xl text-primary">
        Two tincture strengths. One simple dropper.
      </h1>

      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed max-w-[36ch]">
        <span class="block">Botanica makes 10 ml cannabis tinctures in two strengths: 25 mg THC and 50 mg THC per bottle.</span>
        <span class="block mt-3">Learn the format here. Approved members can open the private Store to see current prices, availability, batch details and member offers.</span>
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <MemberAccessCta variant="hero" client:load />
        <a
          href="#range"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-outline px-8 py-3.5 font-label-sm text-label-sm uppercase tracking-widest text-primary text-center hover:bg-surface-container active:scale-[0.98] transition-colors"
        >
          See the tinctures
        </a>
      </div>
    </div>

    <div class="md:col-span-5 lg:col-span-6 load-in [animation-delay:150ms]">
      <figure class="relative max-w-md md:ml-auto">
        <div class="aspect-[4/5] rounded-xl overflow-hidden botanical-shadow bg-surface-container-low">
          <img
            src={HERO_IMAGE}
            alt="Tincture bottle and botanicals on a linen surface"
            referrerpolicy="no-referrer"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
            width="800"
            height="1000"
          />
        </div>
        <figcaption class="font-body-sm text-body-sm text-on-surface-variant mt-3">
          A small-batch tincture in a discreet dropper bottle.
        </figcaption>
      </figure>
    </div>
  </div>
</section>
