---
import { ShieldCheck, FlaskConical, Timer, Scale } from 'lucide-react';
import { HERO_IMAGE } from '@/data/landing';

const trustItems = [
  { icon: ShieldCheck, label: 'Third-Party Lab Tested' },
  { icon: FlaskConical, label: 'CO2 Extracted, Zero Solvents' },
  { icon: Timer, label: 'Predictable Onset Windows' },
  { icon: Scale, label: 'Milligram-Exact Bottles' },
];
---

<section class="w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center py-10 md:py-16">
    <div class="md:col-span-7 lg:col-span-6 space-y-stack-md load-in">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-secondary-container/40 rounded-full border border-outline-variant/40">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary" aria-hidden="true"></span>
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
          Private Botanical Apothecary
        </span>
      </div>

      <h1 class="font-display-lg md:font-display-xl text-display-lg md:text-display-xl text-primary">
        Know exactly what's in the dropper.
      </h1>

      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed max-w-[34ch]">
        Lab-verified tinctures with exact milligram math, a predictable onset window, and a calmer way to end the day.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <a
          href="#mechanism"
          class="px-8 py-3.5 bg-primary text-on-primary font-label-sm text-label-sm uppercase tracking-widest font-bold rounded-full text-center hover:opacity-90 active:scale-[0.98] transition-all"
        >
          Learn the Method
        </a>
        <a
          href="/invite"
          class="px-8 py-3.5 border border-outline text-primary font-label-sm text-label-sm uppercase tracking-widest rounded-full text-center hover:bg-surface-container active:scale-[0.98] transition-colors"
        >
          Apply for Member Access
        </a>
      </div>
    </div>

    <div class="md:col-span-5 lg:col-span-6 load-in [animation-delay:150ms]">
      <figure class="relative max-w-md md:ml-auto">
        <div class="aspect-[4/5] rounded-xl overflow-hidden botanical-shadow bg-surface-container-low">
          <img
            src={HERO_IMAGE}
            alt="Botanica tincture bottle and botanicals on a linen surface"
            referrerpolicy="no-referrer"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
            width="800"
            height="1000"
          />
        </div>
        <figcaption class="font-body-sm text-body-sm text-on-surface-variant mt-3">
          The Balance Tincture, batch-numbered and third-party tested.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section aria-label="Quality standards" class="border-y border-outline-variant/40 bg-surface-container-lowest">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-2 md:grid-cols-4 md:divide-x md:divide-outline-variant/30">
      {trustItems.map(({ icon: Icon, label }) => (
        <div class="flex items-center gap-3 py-5 md:py-6 md:justify-center px-2">
          <Icon size={20} strokeWidth={1.5} className="text-secondary shrink-0" aria-hidden="true" />
          <span class="font-label-sm text-xs uppercase tracking-widest text-on-surface-variant font-bold">
            {label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
