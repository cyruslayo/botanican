---
/**
 * Why timing varies:
 * Educational section focusing on four simple factors:
 * Route, Food, Individual differences, Previous experience.
 */

const factors = [
  {
    title: 'Route',
    body: 'Holding the tincture under the tongue can feel sooner, while swallowing it routes the oil through digestion.',
  },
  {
    title: 'Food',
    body: 'Taking a tincture on an empty stomach or alongside a meal changes how quickly your body absorbs it.',
  },
  {
    title: 'Individual differences',
    body: 'Each person processes cannabinoids differently depending on personal physiology and daily state.',
  },
  {
    title: 'Previous experience',
    body: 'Familiarity with tinctures or edibles shapes how comfortable and noticeable each draw feels.',
  },
];
---

<section id="variables" class="w-full bg-surface-container-low border-b border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
        Personal Factors
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary">Timing is personal.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Cannabis does not run on a mechanical schedule. Several straightforward factors influence how timing unfolds.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mt-12 reveal-group">
      {factors.map((factor) => (
        <div class="bg-surface rounded-2xl p-6 sm:p-8 border border-outline-variant/40 botanical-shadow space-y-2">
          <span class="font-label-sm text-xs uppercase tracking-widest text-secondary font-bold block">
            Factor
          </span>
          <h3 class="font-headline-sm text-headline-sm text-primary">{factor.title}</h3>
          <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
            {factor.body}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 p-6 rounded-2xl bg-secondary-container/50 border border-outline-variant/40 reveal max-w-2xl">
      <p class="font-body-md text-body-md text-on-secondary-container leading-relaxed">
        Compare your own experiences under similar conditions instead of copying someone else’s routine.
      </p>
    </div>
  </div>
</section>
