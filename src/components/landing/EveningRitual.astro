---
/**
 * P3.1 - Evening routine as psychological cue.
 * P3.2 - Botanical mocktail ritual.
 * P3.3 - Habit stacking with breathwork / journaling.
 * P3.5 - Environment design (lighting, screens, sensory prep).
 * P3.6 - Tracking the experience (one-line log).
 */
import { HERO_IMAGE } from '@/data/landing';

const steps = [
  {
    time: 'Step 01',
    title: 'Finishing work',
    body: 'Close the laptop and set work notifications aside. A clear line marks the end of the day before the evening starts.',
  },
  {
    time: 'Step 02',
    title: 'Reducing stimulation',
    body: 'Dim overhead lighting and lower ambient noise. Cues in your immediate environment signal the shift.',
  },
  {
    time: 'Step 03',
    title: 'Preparing the evening',
    body: 'Prepare a quiet space, a warm beverage, or ten minutes of uninterrupted stillness.',
  },
  {
    time: 'Step 04',
    title: 'Taking the tincture',
    body: 'Take your chosen visual draw using a consistent route—either held under the tongue or swallowed.',
  },
  {
    time: 'Step 05',
    title: 'Noting the experience',
    body: 'Keep an unhurried perspective. Note the timing and visual draw so future evenings have a reliable baseline.',
  },
];
---

<section id="ritual" class="w-full bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
        Evening Routine
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary">A deliberate evening starts before the dropper.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Botanica is built for unhurried evenings after work concludes. The routine sets the pace so the experience has space to be understood.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter md:gap-x-16 mt-12 items-start">
      <ol class="md:col-span-7 reveal-group">
        {steps.map((step) => (
          <li class="grid grid-cols-[4.5rem_1fr] gap-x-6">
            <span class="font-mono text-xs font-bold text-secondary pt-1 text-right">{step.time}</span>
            <div class="relative border-l border-outline-variant/40 pl-6 pb-8 last:pb-0">
              <span
                class="absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-secondary border-2 border-surface"
                aria-hidden="true"></span>
              <h3 class="font-headline-sm text-headline-sm text-primary">{step.title}</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed max-w-[52ch]">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="hidden md:block md:col-span-5 reveal">
        <figure class="sticky top-24">
          <div class="aspect-[3/4] rounded-xl overflow-hidden botanical-shadow bg-surface-container-low">
            <img
              src={HERO_IMAGE}
              alt="A dim evening table set with a tincture, glass, and journal"
              referrerpolicy="no-referrer"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
              width="800"
              height="1067"
            />
          </div>
          <figcaption class="font-body-sm text-body-sm text-on-surface-variant mt-3">
            Same hour, same seat, same cues. That is the whole trick.
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
