---
/**
 * P4.1 - Reading an independent certificate of analysis.
 * P4.2 - What THC and CBD numbers mean.
 * P4.3 - Full-spectrum vs broad-spectrum vs isolate.
 * Document figures are illustrative and labeled as such.
 */
const cannabinoids = [
  { name: 'Delta-9 THC', value: '2.1 mg per serving', marker: '2' },
  { name: 'CBD', value: '18.4 mg per serving', marker: null },
  { name: 'CBG', value: '0.9 mg per serving', marker: null },
  { name: 'Total terpenes', value: '0.42% by weight', marker: null },
];

const legend = [
  {
    n: '1',
    title: 'Batch identity',
    body: 'Ties the report to your bottle, not to a product line.',
  },
  {
    n: '2',
    title: 'Cannabinoid values in milligrams',
    body: 'Potency you can dose against, not adjectives.',
  },
  {
    n: '3',
    title: 'The safety panel',
    body: 'A pass here matters more than any potency number.',
  },
  {
    n: '4',
    title: 'Who ran it',
    body: 'An independent third-party lab, not the brand worksheet.',
  },
];

const spectrums = [
  {
    name: 'Full-spectrum',
    body: 'The whole plant, trace THC included. The complete entourage.',
  },
  {
    name: 'Broad-spectrum',
    body: 'The plant with the THC removed. Depth without it.',
  },
  {
    name: 'Isolate',
    body: 'One compound, alone. Predictable, but on its own.',
  },
];
---

<section id="proof" class="w-full bg-surface-container-low border-b border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-20 md:py-28">
    <div class="max-w-2xl space-y-stack-md reveal">
      <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
        Read the Report
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary">How to read a lab report</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
        Every batch ships with a certificate of analysis. Here is how to read one in under a minute.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter md:gap-x-16 mt-12 items-start">
      <div class="md:col-span-6 reveal">
        <div class="bg-surface rounded-xl border border-outline-variant/60 botanical-shadow p-6 sm:p-8 relative">
          <p class="font-mono text-[11px] uppercase tracking-widest text-on-surface-variant">
            Certificate of Analysis
          </p>
          <h3 class="font-headline-sm text-headline-sm text-primary mt-2">Botanica Balance Tincture</h3>

          <div class="flex items-start justify-between gap-4 mt-4 pb-4 border-b border-outline-variant/40">
            <div>
              <p class="font-body-sm text-body-sm text-primary font-bold">Batch BT-2481</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Harvested 08/2026, tested 08/2026</p>
            </div>
            <span class="w-5 h-5 rounded-full bg-primary text-on-primary font-mono text-[10px] font-bold flex items-center justify-center shrink-0">1</span>
          </div>

          <dl class="divide-y divide-outline-variant/30">
            {cannabinoids.map((row) => (
              <div class="flex items-center justify-between gap-4 py-3">
                <dt class="font-body-sm text-body-sm text-primary font-bold">{row.name}</dt>
                <dd class="flex items-center gap-3">
                  <span class="font-mono text-sm text-on-surface-variant">{row.value}</span>
                  {row.marker && (
                    <span class="w-5 h-5 rounded-full bg-primary text-on-primary font-mono text-[10px] font-bold flex items-center justify-center">{row.marker}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>

          <div class="flex items-start justify-between gap-4 py-3 border-t border-outline-variant/40">
            <div>
              <p class="font-body-sm text-body-sm text-primary font-bold">Safety panel</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Pesticides, heavy metals, residual solvents</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="font-mono text-sm font-bold text-secondary uppercase">Pass</span>
              <span class="w-5 h-5 rounded-full bg-primary text-on-primary font-mono text-[10px] font-bold flex items-center justify-center">3</span>
            </div>
          </div>

          <div class="flex items-start justify-between gap-4 pt-4 mt-1 border-t border-outline-variant/40">
            <div>
              <p class="font-body-sm text-body-sm text-primary font-bold">Meridian Analytical Laboratories</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Independent, accredited</p>
            </div>
            <span class="w-5 h-5 rounded-full bg-primary text-on-primary font-mono text-[10px] font-bold flex items-center justify-center shrink-0">4</span>
          </div>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant/80 mt-3">
          Sample document, figures illustrative. Every Botanica batch ships with its own report.
        </p>
      </div>

      <div class="md:col-span-6 space-y-2 reveal">
        {legend.map((item) => (
          <div class="flex gap-4 py-4 border-b border-outline-variant/40 last:border-b-0">
            <span class="w-5 h-5 rounded-full bg-primary text-on-primary font-mono text-[10px] font-bold flex items-center justify-center shrink-0 mt-1">{item.n}</span>
            <div>
              <h4 class="font-headline-sm text-headline-sm text-primary">{item.title}</h4>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 reveal">
      <div class="bg-surface rounded-xl border border-outline-variant/40 md:divide-x md:divide-outline-variant/30 grid grid-cols-1 md:grid-cols-3">
        {spectrums.map((spectrum) => (
          <div class="p-6 sm:p-8">
            <h4 class="font-headline-sm text-headline-sm text-primary">{spectrum.name}</h4>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-2 leading-relaxed">{spectrum.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
