---
import { ARTICLES, type Article } from '@/data/journal';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles?: Article[];
}

const { articles = ARTICLES } = Astro.props;
const remainingArticles = articles.filter((a) => !a.featured);
---

<section id="dispatches" class="w-full bg-surface-container-low border-b border-outline-variant/30 py-20 md:py-28">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
      <div class="max-w-2xl space-y-2">
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
          Field Notes &bull; Monographs &bull; Method
        </span>
        <h2 class="font-headline-lg text-headline-lg text-primary">
          From the Botanica Journal
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
          Guides for understanding tinctures, deliberate use, cannabis routines, and the strains behind each Botanica batch.
        </p>
      </div>

      <a
        href="/journal"
        class="font-label-sm text-xs uppercase tracking-widest text-primary font-bold underline underline-offset-4 hover:text-secondary transition-colors shrink-0"
      >
        View Complete Gazette &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
      {remainingArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </div>
</section>
