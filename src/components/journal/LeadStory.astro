---
import type { Article } from '@/data/journal';

interface Props {
  article: Article;
}

const { article } = Astro.props;

const authorInitials = article.author?.name
  ? article.author.name
      .split(' ')
      .filter((part: string) => !part.includes('.'))
      .map((n: string) => n[0])
      .join('')
      .slice(0, 2)
      .toUpperCase() || 'BR'
  : 'BR';
---

<section id="lead-story" class="w-full border-b border-outline-variant/40 bg-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 space-y-5">
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 bg-secondary-container/60 rounded-full font-label-sm text-xs font-bold uppercase tracking-widest text-secondary">
            Lead Editorial &bull; {article.category}
          </span>
          <span class="font-mono text-xs text-on-surface-variant">
            {article.volume} &bull; {article.readTime}
          </span>
        </div>

        <h2 class="font-display-lg md:font-display-xl text-display-lg md:text-display-xl text-primary leading-tight">
          <a href={`/journal/${article.slug}`} class="hover:opacity-85 transition-opacity">
            {article.title}
          </a>
        </h2>

        <p class="font-headline-sm text-headline-sm text-primary/80 italic font-normal">
          &ldquo;{article.thesis}&rdquo;
        </p>

        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed max-w-[54ch]">
          {article.excerpt}
        </p>

        <div class="pt-3 flex flex-col sm:flex-row sm:items-center gap-4">
          <a
            href={`/journal/${article.slug}`}
            class="inline-flex items-center justify-center px-8 py-3.5 bg-primary text-on-primary font-label-sm text-label-sm uppercase tracking-widest font-bold rounded-full hover:opacity-90 active:scale-[0.98] transition-all"
          >
            Read the Monograph &rarr;
          </a>

          <div class="flex items-center gap-3 pl-1">
            <span class="w-7 h-7 rounded-full bg-surface-container-high text-primary font-mono text-xs flex items-center justify-center font-bold">
              {authorInitials}
            </span>
            <div class="text-left">
              <p class="font-body-sm text-body-sm font-bold text-primary leading-tight">{article.author.name}</p>
              <p class="font-body-sm text-xs text-on-surface-variant">{article.author.role}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <figure class="relative rounded-2xl overflow-hidden botanical-shadow bg-surface-container-low aspect-[4/5] max-w-md mx-auto lg:ml-auto">
          <img
            src={article.image}
            alt={article.title}
            referrerpolicy="no-referrer"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
            width="800"
            height="1000"
          />
          <figcaption class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-primary/90 via-primary/50 to-transparent text-on-primary font-body-sm text-xs">
            Botanical Formulation Archives &bull; Vol. IV
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
